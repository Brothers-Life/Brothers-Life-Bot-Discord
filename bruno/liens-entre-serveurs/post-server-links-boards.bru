docs {
  Créer / agir — `POST /api/server-links/boards`

  Permission requise : `serverlinks.manage`

  Corps JSON :
  - `name` (string) — obligatoire
  - `guildId` (string) — obligatoire
  - `channelId` (string) — obligatoire
  - `enabled` (boolean)
  - `payload` (object)
  - `line` (string)
  - `compact` (boolean)
  - `layout` ("list" | "cards" | "categories")
  - `logos` (boolean)
  - `categoryImage` ("tiles" | "slices" | "rows" | "picture" | "none")
  - `serverImage` ("thumbnail" | "banner" | "none")
  - `imageColumns` (integer)
  - `imageNames` (boolean)
  - `imageStats` (boolean)
  - `categoryIds` (array)
  - `groupByCategory` (boolean)
  - `categoryHeader` (string)
  - `scope` ("all" | "selected")
  - `guildIds` (array)
  - `includeSelf` (boolean)
  - `buttons` (boolean)
  - `repost` (boolean)
}
