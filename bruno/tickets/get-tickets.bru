docs {
  Consulter — `GET /api/tickets`

  Permission requise : `tickets.view`

  Paramètres de requête :
  - `guildId` (string)
  - `status` ("open" | "closed")
  - `statusKey` (string)
  - `categoryId` (integer)
  - `priority` ("low" | "normal" | "high" | "urgent")
  - `claimedBy` (string)
  - `openerId` (string)
  - `before` (integer)
  - `limit` (integer)
}
