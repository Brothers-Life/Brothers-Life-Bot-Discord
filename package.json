{
  "name": "bot-discord-brl",
  "version": "1.11.0",
  "description": "Bot Discord Brothers Life : bot, API, front (panel) et base PostgreSQL séparés",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:bot": "node src/bot.js dev",
    "dev:api": "node src/api.js dev",
    "dev:front": "node src/front.js dev",
    "start": "node launcher.js prod",
    "start:app": "node src/index.js prod",
    "lint": "eslint src/ test/ launcher.js launcher/",
    "test": "node --test \"test/**/*.test.js\"",
    "db:test": "docker run -d --name brl-pg -p 5432:5432 -e POSTGRES_PASSWORD=root --tmpfs /var/lib/postgresql/data:rw postgres:17 -c fsync=off -c synchronous_commit=off -c max_connections=300",
    "db:migrate-sqlite": "node scripts/migrate-sqlite.mjs",
    "deploy:dev": "node src/bot/deploy-commands.js dev",
    "deploy:prod:guild": "node src/bot/deploy-commands.js prod",
    "deploy:global": "node src/bot/deploy-commands.js prod --global",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "egg": "node pterodactyl/build-egg.mjs",
    "bruno": "node scripts/build-bruno.mjs",
    "start:bot": "node launcher.js prod bot",
    "start:api": "node launcher.js prod api",
    "start:front": "node launcher.js prod front"
  },
  "author": "Arthur Corbères",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@napi-rs/canvas": "^1.0.9",
    "discord.js": "^14.25.1",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5",
    "node-cron": "^4.2.1",
    "opusscript": "^0.0.8",
    "pg": "^8.13.1",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
