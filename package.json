{
  "name": "bot-discord-brl",
  "version": "1.0.0",
  "description": "Bot Discord BRL (based on arthurcorberes/discordjs-bot-template)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "start": "node launcher.js prod",
    "start:app": "node src/index.js prod",
    "lint": "eslint src/ test/ launcher.js launcher/",
    "test": "node --test \"test/**/*.test.js\"",
    "deploy:dev": "node src/bot/deploy-commands.js dev",
    "deploy:prod:guild": "node src/bot/deploy-commands.js prod",
    "deploy:global": "node src/bot/deploy-commands.js prod --global",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "egg": "node pterodactyl/build-egg.mjs"
  },
  "author": "Arthur Corbères",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.25.1",
    "fastify": "^5.12.5",
    "node-cron": "^4.2.1",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
