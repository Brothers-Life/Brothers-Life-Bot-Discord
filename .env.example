# Copier en .env.dev (local) et .env.prod (production), puis remplir.
# Sur Pterodactyl, les mêmes clés peuvent être définies comme variables de démarrage
# (elles passent avant le fichier).

# --- Discord (https://discord.com/developers/applications) ---
TOKEN=
APP_ID=
# OAuth2 > Client Secret (connexion au panel)
CLIENT_SECRET=
# Serveur de test pour npm run deploy:dev
DEV_GUILD_ID=

# --- Chef du réseau ---
# Seul compte qui a TOUTES les permissions. Un seul ID, non modifiable depuis le panel.
OWNER_ID=267235400467218432

# --- Panel web ---
WEB_PORT=3000
# http | https-selfsigned | https-custom
WEB_MODE=http
# Adresse du panel vue par le navigateur, sans slash final.
# À ajouter aussi dans Discord > OAuth2 > Redirects : <WEB_PUBLIC_URL>/api/auth/callback
WEB_PUBLIC_URL=http://localhost:3000
# Seulement pour https-custom
TLS_CERT=
TLS_KEY=

# --- Base PostgreSQL ---
# Soit une URL complète, soit les variables DB_* (le mot de passe peut alors contenir n'importe quel caractère)
DATABASE_URL=postgres://brl:motdepasse@127.0.0.1:5432/brl
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Déploiement séparé (bot, API, front : docs/architecture.md) ---
# Inutile en tout-en-un (npm run dev / npm start)
# Secret partagé par le bot, l'API et le front (32 caractères ou plus, le même partout)
INTERNAL_TOKEN=
# API : le front comme seul relais de confiance
SERVE_PANEL=false
TRUST_PROXY=127.0.0.1
# Front et bot : adresse de l'API (le bot s'y connecte sur /internal/bot, il n'ouvre aucun port)
API_URL=http://127.0.0.1:3001

# --- Versions (page Versions du panel) ---
# owner/repo
GITHUB_REPO=Brothers-Life/Brothers-Life-Bot-Discord
# Token GitHub en lecture seule (Contents: read), seulement si le dépôt est privé
GITHUB_TOKEN=

USE_TRANSLATION_CACHE=true
