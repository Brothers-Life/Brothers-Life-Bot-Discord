# Copier en .env.dev (local) et .env.prod (production), puis remplir.
# Sur Pterodactyl, les mêmes clés peuvent être définies comme variables de démarrage
# (elles passent avant le fichier).

# --- Discord (https://discord.com/developers/applications) ---
TOKEN=
APP_ID=
# OAuth2 > Client Secret (connexion au panel)
CLIENT_SECRET=
# Serveur de test pour npm run deploy:dev
DEV_GUILD_ID=

# --- Chef du réseau ---
# Seul compte qui a TOUTES les permissions. Un seul ID, non modifiable depuis le panel.
OWNER_ID=267235400467218432

# --- Panel web ---
WEB_PORT=3000
# http | https-selfsigned | https-custom
WEB_MODE=http
# Adresse du panel vue par le navigateur, sans slash final.
# À ajouter aussi dans Discord > OAuth2 > Redirects : <WEB_PUBLIC_URL>/api/auth/callback
WEB_PUBLIC_URL=http://localhost:3000
# Seulement pour https-custom
TLS_CERT=
TLS_KEY=

# --- Versions (page Versions du panel) ---
# owner/repo
GITHUB_REPO=Brothers-Life/Brothers-Life-Bot-Discord
# Token GitHub en lecture seule (Contents: read), seulement si le dépôt est privé
GITHUB_TOKEN=

USE_TRANSLATION_CACHE=true
