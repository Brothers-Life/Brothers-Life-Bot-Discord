# For docker compose: copy to .env next to docker-compose.yml, then fill it in.
# docker-compose.yml hands each container only what it needs from here (the token goes to the bot only).

# --- Database (PostgreSQL container) ---
# Long random password; the bot and the API use it too
DB_PASSWORD=

# --- Link between the API and the bot ---
# Long random secret, 32 characters or more (e.g. openssl rand -hex 32)
INTERNAL_TOKEN=

# --- Discord (https://discord.com/developers/applications) ---
TOKEN=
APP_ID=
# Test server for slash commands (optional)
DEV_GUILD_ID=
CLIENT_SECRET=
OWNER_ID=

# --- Panel ---
# Port opened on the machine for the panel
PANEL_PORT=3000
# Address of the panel seen by browsers, without trailing slash. Add <WEB_PUBLIC_URL>/api/auth/callback
# to Discord > OAuth2 > Redirects. https-selfsigned / https-custom are handled by the front.
WEB_PUBLIC_URL=http://localhost:3000
WEB_MODE=http
TLS_CERT=
TLS_KEY=

# --- Versions (page Versions du panel: shows the new versions; with Docker, update by rebuilding the image) ---
GITHUB_REPO=Brothers-Life/Brothers-Life-Bot-Discord
GITHUB_TOKEN=
